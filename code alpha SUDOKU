#include <iostream>
using namespace std;
const int N=9;
bool ok(int g[N][N],int r,int c,int x){
 for(int i=0;i<9;i++) if(g[r][i]==x||g[i][c]==x) return false;
 int sr=r-r%3,sc=c-c%3;
 for(int i=0;i<3;i++)for(int j=0;j<3;j++) if(g[sr+i][sc+j]==x) return false;
 return true;
}
bool solve(int g[N][N]){
 for(int r=0;r<9;r++)for(int c=0;c<9;c++) if(g[r][c]==0){
   for(int x=1;x<=9;x++) if(ok(g,r,c,x)){ g[r][c]=x; if(solve(g)) return true; g[r][c]=0; }
   return false;
 }
 return true;
}
int main(){
 int g[N][N];
 cout<<"Enter 9x9 grid (0 for empty):\n";
 for(int i=0;i<9;i++)for(int j=0;j<9;j++)cin>>g[i][j];
 if(solve(g)){
  for(int i=0;i<9;i++){for(int j=0;j<9;j++) cout<<g[i][j]<<" "; cout<<"\n";}
 }else cout<<"No solution\n";
}
